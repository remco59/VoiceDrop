<UserControl x:Class="VoiceDrop.DictionaryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,30,36,30" MaxWidth="820" HorizontalAlignment="Stretch">
            <TextBlock Style="{StaticResource PageTitle}" Text="Dictionary" />
            <TextBlock Style="{StaticResource Secondary}" Margin="0,4,0,22"
                       Text="Names, brands and jargon that get misheard. Every word helps the model recognise it, and 'misheard as' spellings are replaced automatically." />

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Add a word" Margin="0,0,0,12" />
                    <TextBlock Style="{StaticResource Secondary}" Text="Word or phrase (written exactly like this)" Margin="0,0,0,6" />
                    <Grid>
                        <TextBox x:Name="TermBox" Padding="12,9" KeyDown="Input_KeyDown" />
                        <TextBlock x:Name="TermHint" Text="e.g. VoiceDrop, Afterhours Agency, Kubernetes" Foreground="{DynamicResource TextTertiary}"
                                   Margin="14,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                    </Grid>
                    <TextBlock Style="{StaticResource Secondary}" Text="Often misheard as (optional, separate with commas)" Margin="0,14,0,6" />
                    <Grid>
                        <TextBox x:Name="VariantBox" Padding="12,9" KeyDown="Input_KeyDown" />
                        <TextBlock x:Name="VariantHint" Text="e.g. voice drop, voicedrop, voice trop" Foreground="{DynamicResource TextTertiary}"
                                   Margin="14,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                    </Grid>
                    <Button x:Name="AddBtn" Style="{StaticResource AccentButton}" Content="Add to dictionary" HorizontalAlignment="Left"
                            Margin="0,16,0,0" Click="Add_Click" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock x:Name="CountText" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
                    <StackPanel x:Name="List" />
                    <TextBlock x:Name="Empty" Style="{StaticResource Secondary}" Text="No words yet." />
                    <TextBlock x:Name="LimitNote" Style="{StaticResource Secondary}" FontSize="11" Margin="0,10,0,0" Visibility="Collapsed"
                               Text="Only the first words fit in the model's hint. Replacements below still apply to every entry." />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
