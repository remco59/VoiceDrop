<UserControl x:Class="VoiceDrop.VoiceEnginePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,30,36,30" MaxWidth="820" HorizontalAlignment="Stretch">
            <TextBlock Style="{StaticResource PageTitle}" Text="Voice Engine" />
            <TextBlock Style="{StaticResource Secondary}" Margin="0,4,0,22" Text="Speech recognition runs fully on your GPU (Vulkan), with CPU as fallback." />

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Language" />
                    <TextBlock Style="{StaticResource Secondary}" Margin="0,2,0,12"
                               Text="Auto-detect picks the language per recording, so you can mix Dutch and English. Fix it to one language for slightly better accuracy." />
                    <WrapPanel x:Name="Langs" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Speech model" Margin="0,0,0,10" />
                    <StackPanel x:Name="Models" />
                    <ProgressBar x:Name="Progress" Height="4" Minimum="0" Maximum="1" Margin="0,8,0,0" Visibility="Collapsed"
                                 Foreground="{DynamicResource Accent}" Background="{DynamicResource Selected}" BorderThickness="0" />
                    <TextBlock x:Name="ModelStatus" Style="{StaticResource Secondary}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Live preview" />
                        <TextBlock Style="{StaticResource Secondary}" Margin="0,2,0,0"
                                   Text="Show words in the overlay while you speak. Uses a bit more GPU." />
                    </StackPanel>
                    <CheckBox x:Name="LiveToggle" Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
