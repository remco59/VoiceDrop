<UserControl x:Class="VoiceDrop.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,30,36,30" MaxWidth="820" HorizontalAlignment="Stretch">
            <TextBlock Style="{StaticResource PageTitle}" Text="Dashboard" />
            <TextBlock Style="{StaticResource Secondary}" Margin="0,4,0,22" Text="Local dictation for every app. Nothing leaves your PC." />

            <!-- hero -->
            <Border Style="{StaticResource Card}" Padding="24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Hold to talk, release to type" FontSize="19" FontWeight="SemiBold" />
                        <TextBlock x:Name="HeroSub" Style="{StaticResource Secondary}" Margin="0,6,0,0"
                                   Text="Your words are inserted wherever your cursor is." />
                    </StackPanel>
                    <Border Grid.Column="1" Background="{DynamicResource CardElevated}" BorderBrush="{DynamicResource CardBorder}"
                            BorderThickness="1,1,1,3" CornerRadius="9" Padding="18,10" VerticalAlignment="Center">
                        <TextBlock x:Name="KeyCap" FontSize="16" FontWeight="SemiBold" />
                    </Border>
                </Grid>
            </Border>

            <!-- today -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Margin="0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Secondary}" Text="Words today" />
                        <TextBlock x:Name="WordsToday" FontSize="30" FontWeight="Bold" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Secondary}" Text="Dictations today" />
                        <TextBlock x:Name="CountToday" FontSize="30" FontWeight="Bold" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="4" Style="{StaticResource Card}" Margin="0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Secondary}" Text="Speaking speed" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock x:Name="WpmToday" FontSize="30" FontWeight="Bold" />
                            <TextBlock Style="{StaticResource Secondary}" Text="wpm" VerticalAlignment="Bottom" Margin="6,0,0,6" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- try it -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Try it" />
                    <TextBlock Style="{StaticResource Secondary}" Margin="0,2,0,10"
                               Text="Click in the box, then hold your hotkey and speak Dutch or English." />
                    <Grid>
                        <TextBox x:Name="TryBox" MinHeight="96" AcceptsReturn="True" TextWrapping="Wrap" Padding="12" VerticalContentAlignment="Top" />
                        <TextBlock x:Name="TryHint" Style="{StaticResource Secondary}" Margin="14,12,0,0" IsHitTestVisible="False"
                                   Foreground="{DynamicResource TextTertiary}" Text="Your dictation appears here..." />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- recent -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Recent" Margin="0,0,0,8" />
                    <StackPanel x:Name="Recent" />
                    <TextBlock x:Name="RecentEmpty" Style="{StaticResource Secondary}" Text="Nothing yet. Your last dictations show up here." />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
