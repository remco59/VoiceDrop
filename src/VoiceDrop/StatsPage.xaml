<UserControl x:Class="VoiceDrop.StatsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,30,36,30" MaxWidth="820" HorizontalAlignment="Stretch">
            <TextBlock Style="{StaticResource PageTitle}" Text="Stats" />
            <TextBlock Style="{StaticResource Secondary}" Margin="0,4,0,22" Text="How much you have talked instead of typed." />

            <UniformGrid Columns="4" Margin="0,0,-14,0">
                <Border Style="{StaticResource Card}" Margin="0,0,14,14">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Secondary}" Text="Total words" />
                        <TextBlock x:Name="TotalWords" FontSize="26" FontWeight="Bold" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,14,14">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Secondary}" Text="Dictations" />
                        <TextBlock x:Name="TotalCount" FontSize="26" FontWeight="Bold" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,14,14">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Secondary}" Text="Avg. speed" />
                        <TextBlock x:Name="AvgWpm" FontSize="26" FontWeight="Bold" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,14,14">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Secondary}" Text="Time saved*" />
                        <TextBlock x:Name="Saved" FontSize="26" FontWeight="Bold" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Last 7 days" Margin="0,0,0,14" />
                    <Grid x:Name="Chart" Height="170" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Languages" Margin="0,0,0,10" />
                    <StackPanel x:Name="Langs" />
                    <TextBlock x:Name="LangsEmpty" Style="{StaticResource Secondary}" Text="No data yet." />
                </StackPanel>
            </Border>
            <TextBlock Style="{StaticResource Secondary}" FontSize="11" Text="* compared to typing at 40 words per minute." />
        </StackPanel>
    </ScrollViewer>
</UserControl>
