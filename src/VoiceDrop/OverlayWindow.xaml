<Window x:Class="VoiceDrop.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ShowActivated="False" Focusable="False"
        SizeToContent="WidthAndHeight" ResizeMode="NoResize">
    <Border x:Name="Pill" Background="#F2000000" CornerRadius="22" BorderBrush="#33FFFFFF" BorderThickness="1"
            Margin="24" MinWidth="300" MaxWidth="520" Padding="18,12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.5" Color="Black" />
        </Border.Effect>
        <StackPanel>
            <TextBlock x:Name="Preview" Foreground="#E6FFFFFF" FontSize="14" TextWrapping="Wrap"
                       MaxHeight="76" TextTrimming="None" Margin="0,0,0,10" Visibility="Collapsed" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel x:Name="Bars" Orientation="Horizontal" VerticalAlignment="Center" Height="26" />
                <TextBlock x:Name="StatusText" Grid.Column="1" Foreground="#99FFFFFF" FontSize="12"
                           VerticalAlignment="Center" Margin="14,0,0,0" Text="Listening" />
                <Border x:Name="LangChip" Grid.Column="2" Background="#22FFFFFF" CornerRadius="10" Padding="9,3"
                        VerticalAlignment="Center" Visibility="Collapsed">
                    <TextBlock x:Name="LangText" Foreground="#CCFFFFFF" FontSize="11" FontWeight="SemiBold" />
                </Border>
            </Grid>
        </StackPanel>
    </Border>
</Window>
