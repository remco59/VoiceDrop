<UserControl x:Class="VoiceDrop.CleanupPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,30,36,30" MaxWidth="820" HorizontalAlignment="Stretch">
            <TextBlock Style="{StaticResource PageTitle}" Text="Cleanup" />
            <TextBlock Style="{StaticResource Secondary}" Margin="0,4,0,22"
                       Text="Tidy up what you dictated before it is typed: spoken commands, filler words and, with a small local AI model, punctuation and phrasing. Nothing leaves your PC." />

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Mode" Margin="0,0,0,12" />
                    <WrapPanel x:Name="ModeChips" />
                    <TextBlock x:Name="ModeHint" Style="{StaticResource Secondary}" Margin="0,2,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="18,6">
                <StackPanel x:Name="Toggles" />
            </Border>

            <Border x:Name="SmartCard" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="AI model for Smart mode" />
                    <TextBlock Style="{StaticResource Secondary}" Margin="0,2,0,12"
                               Text="Runs locally on your GPU. It fixes punctuation, capitalization, stutters and false starts, and keeps your own words and language." />
                    <StackPanel x:Name="Models" />
                    <ProgressBar x:Name="Progress" Height="4" Minimum="0" Maximum="1" Margin="0,8,0,0" Visibility="Collapsed"
                                 Foreground="{DynamicResource Accent}" Background="{DynamicResource Selected}" BorderThickness="0" />
                    <TextBlock x:Name="ModelStatus" Style="{StaticResource Secondary}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Try it" />
                    <TextBlock Style="{StaticResource Secondary}" Margin="0,2,0,10"
                               Text="Paste a rough dictation and see what the current settings make of it." />
                    <TextBox x:Name="TryIn" MinHeight="70" AcceptsReturn="True" TextWrapping="Wrap" Padding="12"
                             VerticalContentAlignment="Top"
                             Text="Um, so I was thinking, uh, that we should meet on Friday. New line. Dus eh, ik stuur je nog een mail." />
                    <Button x:Name="RunBtn" Style="{StaticResource AccentButton}" Content="Clean it up" HorizontalAlignment="Left" Margin="0,12,0,12" Click="Run_Click" />
                    <TextBox x:Name="TryOut" MinHeight="70" AcceptsReturn="True" TextWrapping="Wrap" Padding="12"
                             VerticalContentAlignment="Top" IsReadOnly="True" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
