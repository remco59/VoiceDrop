<UserControl x:Class="VoiceDrop.HistoryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="36,30,36,0" MaxWidth="820" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Style="{StaticResource PageTitle}" Text="History" />
                <TextBlock Style="{StaticResource Secondary}" Margin="0,4,0,18" Text="Everything you dictated, stored only on this PC." />
            </StackPanel>
            <Button Grid.Column="1" x:Name="ClearBtn" Content="Clear unpinned" VerticalAlignment="Top" Margin="0,6,0,0" Click="Clear_Click" />
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid>
                <TextBox x:Name="Search" Padding="40,10,12,10" TextChanged="Filter_Changed" />
                <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource TextSecondary}"
                           Margin="14,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                <TextBlock x:Name="SearchHint" Text="Search transcriptions..." Foreground="{DynamicResource TextTertiary}"
                           Margin="40,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
            </Grid>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                <RadioButton x:Name="FilterAll" Style="{StaticResource Chip}" Content="All" IsChecked="True" GroupName="hf" Margin="0,0,6,0" Checked="Filter_Changed" />
                <RadioButton x:Name="FilterPinned" Style="{StaticResource Chip}" Content="Pinned" GroupName="hf" Margin="0" Checked="Filter_Changed" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <StackPanel x:Name="List" />
                <TextBlock x:Name="Empty" Style="{StaticResource Secondary}" Margin="0,30,0,0" HorizontalAlignment="Center" Text="No transcriptions yet." />
                <Border Height="24" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
