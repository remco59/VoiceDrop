<Window x:Class="VoiceDrop.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ShowActivated="False" Focusable="False"
        SizeToContent="WidthAndHeight" ResizeMode="NoResize">
    <Grid>
    <Popup x:Name="FullPopup" PlacementTarget="{Binding ElementName=Pill}" Placement="Top" AllowsTransparency="True"
           StaysOpen="True" PopupAnimation="Fade" VerticalOffset="-6" Focusable="False">
        <Border Background="#F2000000" CornerRadius="16" BorderBrush="#33FFFFFF" BorderThickness="1" Padding="16,12" Width="420" Margin="0,0,0,8">
            <ScrollViewer x:Name="FullScroll" MaxHeight="280" VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="FullText" Foreground="#E6FFFFFF" FontSize="14" TextWrapping="Wrap" />
            </ScrollViewer>
        </Border>
    </Popup>
    <Border x:Name="Pill" Background="#F2000000" CornerRadius="22" BorderBrush="#33FFFFFF" BorderThickness="1"
            Margin="24" Width="420" Padding="18,12" MouseEnter="Pill_MouseEnter" MouseLeave="Pill_MouseLeave" MouseLeftButtonDown="Pill_Click">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.5" Color="Black" />
        </Border.Effect>
        <StackPanel>
            <Canvas x:Name="PreviewBox" Width="382" Height="22" ClipToBounds="True" Margin="0,0,0,10" Visibility="Collapsed">
                <Canvas.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#00000000" Offset="0" />
                        <GradientStop Color="#FF000000" Offset="0.6" />
                    </LinearGradientBrush>
                </Canvas.OpacityMask>
                <TextBlock x:Name="Preview" Foreground="#E6FFFFFF" FontSize="14" TextWrapping="NoWrap" />
            </Canvas>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel x:Name="Bars" Orientation="Horizontal" VerticalAlignment="Center" Height="26" />
                <TextBlock x:Name="StatusText" Grid.Column="1" Foreground="#99FFFFFF" FontSize="12"
                           VerticalAlignment="Center" Margin="14,0,0,0" Text="Listening" />
                <Border x:Name="LangChip" Grid.Column="2" Background="#22FFFFFF" CornerRadius="10" Padding="9,3"
                        VerticalAlignment="Center" Visibility="Collapsed">
                    <TextBlock x:Name="LangText" Foreground="#CCFFFFFF" FontSize="11" FontWeight="SemiBold" />
                </Border>
            </Grid>
        </StackPanel>
    </Border>
    </Grid>
</Window>
