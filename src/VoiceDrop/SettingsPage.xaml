<UserControl x:Class="VoiceDrop.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,30,36,30" MaxWidth="820" HorizontalAlignment="Stretch">
            <TextBlock Style="{StaticResource PageTitle}" Text="Settings" />
            <TextBlock Style="{StaticResource Secondary}" Margin="0,4,0,22" Text="Hotkey, overlay and appearance." />

            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Push-to-talk key" />
                        <TextBlock x:Name="HotkeyHint" Style="{StaticResource Secondary}" Margin="0,2,0,0"
                                   Text="Hold this key to dictate. Any single key works, including Ctrl, Alt or Caps Lock." />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{DynamicResource CardElevated}" BorderBrush="{DynamicResource CardBorder}"
                                BorderThickness="1,1,1,3" CornerRadius="8" Padding="14,7" Margin="0,0,10,0">
                            <TextBlock x:Name="KeyCap" FontWeight="SemiBold" />
                        </Border>
                        <Button x:Name="ChangeKey" Content="Change" Click="ChangeKey_Click" PreviewKeyDown="ChangeKey_KeyDown" LostFocus="ChangeKey_LostFocus" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Appearance" Margin="0,0,0,12" />
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="ThemeDark" Style="{StaticResource Chip}" Content="Dark" GroupName="theme" Checked="Theme_Changed" />
                        <RadioButton x:Name="ThemeLight" Style="{StaticResource Chip}" Content="Light" GroupName="theme" Checked="Theme_Changed" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Full text popup" />
                    <TextBlock Style="{StaticResource Secondary}" Margin="0,2,0,12"
                               Text="The overlay shows only the last words. Open the full live text in a popup by hovering or clicking the overlay. Off keeps the overlay click-through." />
                    <WrapPanel x:Name="FullTextChips" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Start sound" />
                    <TextBlock Style="{StaticResource Secondary}" Margin="0,2,0,12" Text="Played when recording starts. Click one to hear it." />
                    <WrapPanel x:Name="SoundChips" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="18,6">
                <StackPanel x:Name="Toggles" />
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
