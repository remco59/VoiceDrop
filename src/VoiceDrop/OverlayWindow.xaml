<Window x:Class="VoiceDrop.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ShowActivated="False" Focusable="False"
        SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True">
    <Grid>

        <!-- glass card -->
        <Border x:Name="Pill" Margin="28" Width="560" CornerRadius="28" Padding="26,20,22,18"
                BorderThickness="1" TextElement.FontFamily="Segoe UI Variable Display, Segoe UI">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.35">
                    <GradientStop Color="#EE2A2D31" Offset="0" />
                    <GradientStop Color="#EE17191C" Offset="0.55" />
                    <GradientStop Color="#F00C0D0F" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#55FFFFFF" Offset="0" />
                    <GradientStop Color="#26FFFFFF" Offset="1" />
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Border.Effect>
                <DropShadowEffect BlurRadius="36" ShadowDepth="10" Direction="270" Opacity="0.45" Color="Black" />
            </Border.Effect>

            <StackPanel>
                <!-- transcript: highest priority, grows up to 3 lines, newest line stays at the bottom -->
                <Canvas x:Name="PreviewBox" Width="510" Height="0" ClipToBounds="True" Margin="0,0,0,16" Visibility="Collapsed">
                    <TextBlock x:Name="Preview" Width="510" Foreground="#F5FFFFFF" FontSize="18" LineHeight="26"
                               LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap" />
                </Canvas>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel x:Name="Bars" Orientation="Horizontal" VerticalAlignment="Center" Height="36" />
                    <Border Grid.Column="1" Width="1" Height="26" Background="#30FFFFFF" Margin="18,0,16,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="StatusText" Grid.Column="2" Foreground="#A8FFFFFF" FontSize="14"
                               VerticalAlignment="Center" Text="Listening" TextTrimming="CharacterEllipsis" />
                    <Border x:Name="LangChip" Grid.Column="3" Background="#2EFFFFFF" CornerRadius="16" Padding="16,6"
                            VerticalAlignment="Center" Visibility="Collapsed">
                        <TextBlock x:Name="LangText" Foreground="#F2FFFFFF" FontSize="15" FontWeight="SemiBold" />
                    </Border>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
